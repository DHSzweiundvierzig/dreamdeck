# Feste Versionen für den Pod. Update nur bewusst: Wert ändern, committen, neuen Pod starten.

COMFYUI_VERSION=v0.45.2

# Standard-Modell-Sets; in RunPod per Variable MODEL_SETS überschreibbar, z. B. "basis fp8". Pro Start nur ein FLUX-Set.
DEFAULT_MODEL_SETS="basis fp16"

# Basis-Image (steht in der RunPod-Vorlage, hier nur zur Info): runpod/pytorch:2.1.0-cu1300-torch2130-ubuntu2404 – PyTorch 2.13.0, CUDA 13.0
