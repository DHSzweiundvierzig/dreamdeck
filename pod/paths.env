# DreamDeck – gemeinsame Pfade und Einstellungen.
#
# Wird von pod/start.sh und pod/sync.sh geladen, später auch vom Dashboard
# (Python liest die Datei). Deshalb nur schlichte Zeilen NAME=Wert:
# keine $-Verweise, keine Anführungszeichen, keine Bash-Ausdrücke.
REPO_DIR=/workspace/dreamdeck
LOG_DIR=/workspace/logs
COMFY_DIR=/workspace/ComfyUI
OUTPUT_DIR=/workspace/output
COMFY_PORT=8188
RCLONE_CONF=/root/.config/rclone/rclone.conf
RCLONE_REMOTE=gdrive
DRIVE_FOLDER=DreamDeck
